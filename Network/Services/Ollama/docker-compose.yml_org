services:
  ollama-arc:
    # This image is maintained by Intel and is the 'gold standard' for Arc/SYCL on Meteor Lake
    # It contains the level-zero/oneAPI libraries natively.
    image: intelanalytics/ipex-llm-inference-cpp-xpu:latest
    container_name: ollama-arc
    entrypoint: ["/usr/local/lib/python3.11/dist-packages/bigdl/cpp/libs/ollama/ollama", "serve"]
    environment:
      - OLLAMA_HOST=0.0.0.0
      # These flags are the 'Magic Sauce' for Intel iGPUs
      - DEVICE=Arc
      - OLLAMA_INTEL_GPU=true
      - ONEAPI_DEVICE_SELECTOR=level_zero:0
      - ZES_ENABLE_SYSMAN=1
      # Since you have 32GB RAM, we'll let it share as needed
      - OLLAMA_KEEP_ALIVE=30m
    volumes:
      - /home/netyeti/.ollama:/root/.ollama
      - /home/netyeti/.ssh/id_ed25519_ollama:/root/.ollama/id_ed25519:ro
      - /home/netyeti/.ssh/id_ed25519_ollama.pub:/root/.ollama/id_ed25519.pub:ro
    devices:
      # This is the 'hole in the wall' for GPU access
      - /dev/dri:/dev/dri
    ports:
      - "11434:11434"
    restart: always
    shm_size: '16gb'  # Shared memory for Intel iGPUs (they share system RAM)
