views:
  - type: table
    name: Table
    filters:
      and:
        - file.name != "index.base"
        - file.inFolder("Network/Devices")
    order:
      - Active
      - file.name
      - services
      - type
      - IP
      - model
      - os
      - Storage
      - RAM
      - Cores
      - MAC
      - networks
      - tags
    sort:
      - property: RAM
        direction: ASC
      - property: formula.Untitled
        direction: ASC
    columnSize:
      note.Active: 31
      file.name: 119
      note.services: 324
      note.type: 80
      note.ip: 119
      note.model: 150
      note.os: 89
      note.Storage: 57
      note.RAM: 50
      note.Cores: 49
  - type: table
    name: View
