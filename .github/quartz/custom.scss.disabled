// Custom styles for Quartz
@use "./base.scss";

// put your custom CSS here!

[saved-theme='dark']  h1, h2, h3, h4, h5, h6, thead{
    text-shadow: 0px 0px 8px #63d4af9a;
}
[saved-theme='dark'] h1 {
    color: #90ffc4;
}
[saved-theme='dark'] h2 {
    color: #6cff9f;
}
[saved-theme='dark'] h3 {
    color: #48d378;
}
[saved-theme='dark'] h4 {
    color: #34b360;
}

[saved-theme='light'] h1, h2, h3, h4, h5, h6, thead{
    text-shadow: 3px 3px 5px #0970139a;
}

div.popover-hint {
    background-color: #015b0a0d;
    padding: 15px;
    border-radius: 15px;
    border-color: black;
    border-width: 1px;
    box-shadow: 3px 3px 7px #000000b3;
}

[saved-theme=light] code[data-theme*=\ ] {
    background-color: #333333;
}

[saved-theme=dark] code[data-theme*=\ ] {
    background-color: #1a1a1a;
}

[saved-theme=light] code[data-theme*=\ ] span {
    color: #46ff7c;
}

[saved-theme=dark] code[data-theme*=\ ] span {
    color: #288f47;
}