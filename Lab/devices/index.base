views:
  - type: table
    name: Table
    filters:
      and:
        - file.name != "index.base"
        - file.inFolder("Lab/devices")
    order:
      - file.name
      - ip
      - ports
      - tags
      - os
    columnSize:
      file.name: 195
      note.ip: 66
  - type: table
    name: View
